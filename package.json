{
  "name": "ibyok",
  "version": "0.1.0",
  "description": "IBYOK CLI: run any command with your stored API keys injected at runtime. No keys in code, .env files or CI.",
  "license": "MIT",
  "author": "IBYOK (https://www.ibyok.com)",
  "homepage": "https://github.com/ibyok/ibyok-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibyok/ibyok-core.git"
  },
  "bugs": {
    "url": "https://github.com/ibyok/ibyok-core/issues"
  },
  "keywords": [
    "ibyok",
    "api-keys",
    "secrets",
    "secrets-management",
    "dotenv",
    "llm",
    "openai",
    "anthropic",
    "cli",
    "agent-skills",
    "claude-code",
    "codex",
    "cursor"
  ],
  "bin": {
    "ibyok": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
